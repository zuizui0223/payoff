{
  "contract_id": "payoff_b_phase_retention_interval_standardization_v1",
  "frozen_date": "2026-09-25",
  "freeze_timing": "before_Aikens_lambda_outcome_opened",
  "Aikens_lambda_outcome_opened": false,
  "purpose": "Separate segment-scale phase retention from interval-normalized equivalent decay and propagated path-memory retention before any Aikens phase-retention outcome is opened.",
  "definitions": {
    "segment_retention_magnitude": "R = abs(lambda)",
    "sign": "sign(lambda); negative values retain the overshoot/sign-reversal flag and are never silently converted to positive lambda",
    "equivalent_decay_constant_per_day": "k_eq = -ln(R) / delta_t_ref_days",
    "equivalent_daily_retention": "R_day = exp(-k_eq) = R^(1/delta_t_ref_days)",
    "equivalent_daily_correction": "1 - R_day",
    "path_memory_retention_homogeneous": "R_path(n) = R^n",
    "path_memory_correction_homogeneous": "1 - R_path(n)"
  },
  "interpretation_limits": [
    "k_eq is an equivalent reference-interval transformation, not a direct continuous-time controller estimate.",
    "When source intervals vary, delta_t_ref_days is the preregistered median observed interval; the IQR is retained as a duration-sensitivity envelope.",
    "R_path propagates only the retained-memory component of the initial phase deviation under a homogeneous transition coefficient; intercepts, new environmental innovations, route-stage heterogeneity, and process noise are not propagated by this summary.",
    "Negative lambda remains an overshoot/sign-reversal case; k_eq describes only the magnitude envelope abs(lambda).",
    "Whole-route cumulative retention is not reported for fixed goose transitions because a common preregistered full-route chain is absent.",
    "SIMEX values are sensitivity scenarios and are not promoted as corrected biological truth."
  ],
  "source_policy": {
    "reference_duration_rule": "median_observed_elapsed_days_on_the_frozen_pair_sample",
    "duration_sensitivity_rule": "report_q25_and_q75_equivalent_k_envelope",
    "wigeon_path_rule": "use observed animal-year transition-count distribution, not total_transitions/unique_individuals",
    "cross_system_primary_rule": "raw lambda remains system-specific primary estimator; interval-normalized quantities are secondary comparison coordinates",
    "Aikens_future_rule": "if the preregistered fixed-24h Aikens contrast becomes estimable, delta_t_ref_days is exactly 1.0 and standardization is secondary to the frozen group contrast"
  },
